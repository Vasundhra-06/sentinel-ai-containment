# ==============================================================================
# SENTINEL - Non-Secret Configuration Environment Example
# ==============================================================================

# API Base URL for Next.js Web Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Environment setting
ENVIRONMENT=development

# Database Configuration (Defaults to local SQLite if unspecified)
# For production PostgreSQL with pgvector:
# DATABASE_URL=postgresql://sentinel_user:sentinel_password@localhost:5432/sentinel_db
# Omit to use the legacy database anchored to apps/api. For an override, use an absolute path:
# DATABASE_URL=sqlite:///C:/path/to/sentinel-app/apps/api/sentinel.db

# Allowed CORS Origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Partner Webhook Demo Secret (Non-secret example for local simulation)
PARTNER_DEMO_SECRET=replace-with-a-local-demo-secret

# Default Retention Window (Days)
DEFAULT_RETENTION_DAYS=30

# New foundation uses a separate DB. Legacy records are never silently imported.
# Omit SENTINEL_DATABASE_URL to use apps/api/foundation.local.db.
# PostgreSQL driver/configuration supported; live PostgreSQL testing is still pending.
# SENTINEL_DATABASE_URL=postgresql+psycopg://user:password@localhost/sentinel
SENTINEL_LEGACY_DEMO=false
NEXT_PUBLIC_FOUNDATION_API_URL=http://127.0.0.1:8000/api/v2
# Files are examples only. Set variables in the process environment; Python does not load .env automatically.
